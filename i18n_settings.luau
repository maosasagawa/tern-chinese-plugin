function M.get_meta(key)
	local item = M.items[key]
	if item then
		return item
	end
	local cat = "other"
	if string.sub(key, 1, 7) == "cursor." then
		cat = "cursor"
	elseif string.sub(key, 1, 13) == "prompt_parts." then
		cat = "prompt"
	elseif string.sub(key, 1, 7) == "agents." or string.sub(key, 1, 6) == "carly." then
		cat = "ai"
	elseif string.sub(key, 1, 6) == "files." or string.sub(key, 1, 10) == "file_tree." then
		cat = "files"
	elseif string.sub(key, 1, 4) == "git." then
		cat = "git"
	elseif string.sub(key, 1, 9) == "notebook." then
		cat = "notebook"
	elseif string.sub(key, 1, 7) == "sqlite." then
		cat = "sqlite"
	elseif string.sub(key, 1, 6) == "cloud." then
		cat = "remote"
	elseif string.sub(key, 1, 6) == "paste." then
		cat = "terminal"
	end
	return { cat = cat, title = key, desc = nil }
end

function M.format_enum(key, val)
	local s = tostring(val)
	local item = M.items[key]
	if item and item.enums and item.enums[s] then
		return item.enums[s] .. " (" .. s .. ")"
	end
	if M.common_enums[s] then
		return M.common_enums[s] .. " (" .. s .. ")"
	end
	return s
end

return M
